# ============================================================================
# BERU — Environment configuration example
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# `.env` is git-ignored and MUST NOT be committed. Never hardcode secrets.
# All variables are OPTIONAL — BERU boots with safe defaults (offline mock LLM).
# ============================================================================

# ---- Application ----------------------------------------------------------
# Environment name: development | staging | production
BERU_ENV=development
# Enable debug behaviour (verbose errors, autoreload hint). true | false
DEBUG=true
# Network binding for the API server.
HOST=127.0.0.1
PORT=8000

# ---- Logging --------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Log format: text (human readable) | json (structured, one object per line)
LOG_FORMAT=text

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins, or "*" for any (dev only).
CORS_ORIGINS=*

# ---- Security / auth ------------------------------------------------------
# Single-user API key. When set, every /api/v1 route requires the X-API-Key
# header to match this value. Blank disables auth (localhost development only).
# BERU refuses to start on a non-localhost interface without a key.
BERU_API_KEY=

# ---- Owner account bootstrap (multi-user auth) ----------------------------
# First-run account: when auth is enabled and no owner exists yet, the app
# creates an owner with these credentials at startup. When
# BERU_OWNER_PASSWORD is blank a random password is generated and used only
# to derive the stored hash — its plaintext is never logged or printed.
BERU_OWNER_USERNAME=owner
BERU_OWNER_PASSWORD=

# ---- Rate limiting --------------------------------------------------------
# Max chat requests per minute per client IP. 0 = unlimited.
BERU_RATE_LIMIT_CHAT_RPM=30
# Burst allowance: max consecutive requests before the limiter kicks in.
BERU_RATE_LIMIT_BURST=5
# Auth-endpoint limits (per client IP): max /auth/login attempts per minute
# and the burst allowance before the limiter activates. 0 = unlimited.
BERU_RATE_LIMIT_AUTH_RPM=10
BERU_RATE_LIMIT_AUTH_BURST=3

# ---- Reverse proxy --------------------------------------------------------
# Honor X-Forwarded-For when rate-limiting. Keep OFF unless BERU genuinely
# sits behind a trusted reverse proxy, otherwise clients can spoof the header
# to dodge the limiter.
BERU_TRUST_PROXY_HEADERS=false

# ---- Request size limits --------------------------------------------------
# Max request body size in bytes (default 1 MB).
BERU_MAX_REQUEST_BODY_BYTES=1048576
# Max message length in characters for the chat endpoint.
BERU_MAX_MESSAGE_LENGTH=32000

# ---- Database -------------------------------------------------------------
# Async SQLAlchemy URL. Default is a local SQLite file via aiosqlite.
DATABASE_URL=sqlite+aiosqlite:///./beru.db
#   Postgres example: point the same URL at a running server.
#   DATABASE_URL=postgresql+asyncpg://beru:beru@localhost:5432/beru
#   (docker compose up) starts exactly such a server.
# Echo SQL statements to the log (noisy — dev debugging only). true | false
DB_ECHO=false

# ---- Health / readiness ---------------------------------------------------
# When true, GET /ready performs a live LLM probe (one minimal generation).
# Off by default so live providers are not billed on every healthcheck tick;
# the built-in mock provider is always probed (instant, free).
# BERU_HEALTH_LLM_PROBE=false

# ---- LLM provider ---------------------------------------------------------
# Which provider implementation to use behind the abstraction layer.
#   mock              -> deterministic offline responses, no network, no key.
#   openai_compatible -> any OpenAI-compatible /chat/completions endpoint.
# Default is "mock" so BERU runs out of the box with zero configuration.
LLM_PROVIDER=mock

# --- Settings for LLM_PROVIDER=openai_compatible ---
# Base URL of the API (no trailing slash). Examples:
#   OpenAI     -> https://api.openai.com/v1
#   Groq       -> https://api.groq.com/openai/v1
#   OpenRouter -> https://openrouter.ai/api/v1
#   Ollama     -> http://localhost:11434/v1
#   LM Studio  -> http://localhost:1234/v1
LLM_BASE_URL=https://api.openai.com/v1
# API key / token. Leave blank for local servers (Ollama, LM Studio).
LLM_API_KEY=
# Model identifier as expected by the provider.
LLM_MODEL=gpt-4o-mini
# Sampling temperature (0.0 - 2.0).
LLM_TEMPERATURE=0.7
# Maximum tokens to generate in a response.
LLM_MAX_TOKENS=1024
# Request timeout in seconds for LLM calls.
LLM_TIMEOUT=60

# ---- Retry / backoff (openai_compatible provider only) --------------------
# Max retry attempts for transient failures (429, 5xx, network errors).
BERU_LLM_MAX_RETRIES=3
# Base delay in seconds for exponential backoff (doubled each retry).
BERU_LLM_RETRY_BASE_DELAY=1.0
# Max delay cap in seconds to prevent excessive waits.
BERU_LLM_RETRY_MAX_DELAY=30.0

# ---- Conversation / memory ------------------------------------------------
# How many recent messages form the short-term memory window sent to the LLM.
MEMORY_WINDOW_SIZE=20
# System prompt used by the default BERU Core agent.
# (Leave unset to use the built-in default.)
# BERU_SYSTEM_PROMPT=You are BERU, a helpful personal AI assistant.

# ---- Memory strategy ------------------------------------------------------
# "window"    = short-term window (default, keeps last N messages).
# "summarise" = summarise older messages when history exceeds the threshold.
# "semantic"  = embedding-based recall of relevant past messages.
BERU_MEMORY_STRATEGY=window
# Number of recent messages kept verbatim when using summarise strategy.
BERU_MEMORY_SUMMARY_KEEP=10
# Message count threshold above which summarisation is triggered.
BERU_MEMORY_SUMMARY_THRESHOLD=20

# ---- Embedding provider ---------------------------------------------------
# Which embedding provider to use for semantic memory.
#   mock              -> deterministic pseudo-embeddings, no network, no key.
#   openai_compatible -> any OpenAI-compatible /embeddings endpoint.
BERU_EMBEDDING_PROVIDER=mock
# Base URL for OpenAI-compatible embeddings (no trailing slash).
BERU_EMBEDDING_BASE_URL=https://api.openai.com/v1
# API key for the embeddings endpoint. Leave blank for local servers.
BERU_EMBEDDING_API_KEY=
# Model identifier for embeddings.
BERU_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension (must match the model's output dimension).
BERU_EMBEDDING_DIMENSION=64

# ---- Long-term memory (facts) ---------------------------------------------
# Facts are durable key-value pairs that persist across conversations.
# They are automatically included in the context sent to the LLM.
# Manage via the API:
#   POST   /api/v1/facts   — create or update a fact
#   GET    /api/v1/facts   — list all facts (optional ?category=...)
#   GET    /api/v1/facts/{key} — get a single fact
#   DELETE /api/v1/facts/{key} — delete a fact (forget)

# ---- Projects (memory scoping) --------------------------------------------
# Projects provide per-project isolation for conversations and facts.
# Facts and conversations can optionally belong to a project.
# Manage via the API:
#   POST   /api/v1/projects   — create a project
#   GET    /api/v1/projects   — list all projects
#   GET    /api/v1/projects/{id} — get a project
#   PATCH  /api/v1/projects/{id} — update a project
#   DELETE /api/v1/projects/{id} — delete a project (cascades to conversations/facts)

# ---- Tool calling ---------------------------------------------------------
# Maximum number of tool-call iterations per request (prevents infinite loops).
BERU_MAX_TOOL_ITERATIONS=10

# ---- Proactive / autonomous ------------------------------------------------
# Start the background scheduler + monitor loops with the app lifespan.
# When false, only the on-demand /api/v1/scheduler & /api/v1/monitor endpoints
# work (no background execution). Set false in tests.
BERU_PROACTIVE_ENABLED=true

# Delete audit history (task runs / trigger fires) older than this many days
# whenever the proactive runtime starts. 0 disables retention pruning; per-object
# pruning is always available via POST .../prune-runs and POST .../prune-fires.
# BERU_PROACTIVE_AUDIT_RETENTION_DAYS=30

# ---- Voice (abstractions; mock by default) ----------------------------------
# STT / TTS provider implementations behind the voice abstraction layer.
#   mock -> deterministic offline stubs (no network, no key).
#   sapi -> built-in Windows SAPI TTS (real speech, requires Windows).
#   Other providers (e.g. real speech engines) plug into the same protocol.
BERU_VOICE_STT_PROVIDER=mock
BERU_VOICE_TTS_PROVIDER=mock
# Whisper model for BERU_VOICE_STT_PROVIDER=whisper (tiny|base|small|medium|large).
# Requires installing the optional voice extra: pip install -e .[voice]
BERU_VOICE_STT_MODEL=base
# Edge TTS voice for BERU_VOICE_TTS_PROVIDER=edge_tts (see edge-tts docs).
# Requires installing the optional voice extra: pip install -e .[voice]
BERU_VOICE_TTS_VOICE=en-US-JennyNeural
# Wake words that trigger "beru" listening (comma-separated).
BERU_VOICE_WAKE_WORDS=beru
# Max audio payload accepted for transcription (bytes) and session lifetime (s).
BERU_VOICE_MAX_AUDIO_BYTES=10000000
BERU_VOICE_SESSION_TIMEOUT=300
# Capture format sent to the STT provider.
BERU_VOICE_SAMPLE_RATE=16000
BERU_VOICE_CHANNELS=1

# ---- Test gates (never set these in production) ----------------------------
# Enable the opt-in live LLM smoke suite (tests/test_real_llm_live.py): fires
# real HTTP requests against LLM_BASE_URL/LLM_MODEL. Default off.
# BERU_REAL_LLM_SMOKE=1
# Enable the opt-in live-hardware suite (tests/test_live_hardware.py): opens a
# real browser, captures the real screen, uses the real clipboard and the
# Windows SAPI voice. Default off.
# BERU_LIVE_HW_TESTS=1

# ---- Command sandbox / host hardening (Stage 5.4) ---------------------------
# Backend used for run_command (tool + API): "host" (local subprocess with the
# allowlist + pattern-blocklist guardrail) or "container" (docker exec into
# BERU_COMMAND_CONTAINER, isolating the child from the host).
BERU_COMMAND_EXECUTOR=host
# Container NAME/ID that receives commands when BERU_COMMAND_EXECUTOR=container
# (e.g. a dedicated sandbox image with no host mounts or credentials).
# BERU_COMMAND_CONTAINER=
# Least-privilege account for host subprocesses. Implemented on POSIX hosts via
# setuid (e.g. "nobody"/"nogroup"); Windows refuses this and requires the
# container backend instead. Blank = run as the current user.
# BERU_COMMAND_RUN_USER=
# BERU_COMMAND_RUN_GROUP=
#
